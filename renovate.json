{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>cmeister2/renovate:yayornay"
  ],
  "packageRules": [
    {
      "description": "Keep HTTP dependencies compatible with the declared Rust 1.59 minimum",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "reqwest"
      ],
      "allowedVersions": "<0.11.19"
    },
    {
      "description": "Keep file detection compatible with Rust 1.59; infer 0.14 and newer use unsupported syntax",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "infer"
      ],
      "allowedVersions": "<0.14"
    },
    {
      "description": "Keep error derivation compatible with Rust 1.59; thiserror 1.0.66 and newer require Rust 1.61 or later",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "thiserror"
      ],
      "allowedVersions": "<1.0.66"
    },
    {
      "description": "Retain dependencies compatible with the declared Rust 1.59 minimum",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "libc"
      ],
      "allowedVersions": "<=0.2.163"
    },
    {
      "description": "Retain dependencies compatible with the declared Rust 1.59 minimum",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "/^futures(?:-|$)/"
      ],
      "allowedVersions": "<=0.3.31"
    },
    {
      "description": "Retain dependencies compatible with the declared Rust 1.59 minimum",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "tokio"
      ],
      "allowedVersions": "<1.30"
    },
    {
      "description": "Retain dependencies compatible with the declared Rust 1.59 minimum",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "tokio-util"
      ],
      "allowedVersions": "<=0.7.8"
    }
  ]
}
